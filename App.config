<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<connectionStrings>

		<add
		  name="SitecoreCustomDb"
		  connectionString="Data Source=xxxxxx\xxxxx;Initial Catalog=xxxxx;Integrated Security=True;TrustServerCertificate=True;"
		  providerName="System.Data.SqlClient" />

		<!--<add name="AccountSql" connectionString="user id=sa;password=MySqlServer@1234;Data Source=WS40163\SQLUSER;Database=wc-uat-sitecore10-custom-db-6Aug2026" providerName="System.Data.SqlClient" />-->

	</connectionStrings>


	<appSettings>

		<add
		  key="OpenAIApiKey"
		  value="xxxxxx" />

		<add
		  key="OpenAIModel"
		  value="xxxxxx" />

	</appSettings>


</configuration>